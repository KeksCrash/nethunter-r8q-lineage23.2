#!/usr/bin/python3
"""lsusb replacement for NetHunter chroot (no udev).
Scans the xHCI platform device tree and /sys/bus/usb/devices/.
SM-G781B quirk: /sys/bus/usb/devices/ is often empty; real devices
live under the xHCI platform path. Uses per-file read timeout to
avoid hanging on suspended USB devices."""
import os, sys, signal

XHCI_BASE = "/sys/devices/platform/soc/a600000.ssusb/a600000.dwc3/xhci-hcd.8.auto"
SYSFS_BASE = "/sys/bus/usb/devices"
READ_TIMEOUT = 3
MAX_DEPTH = 6


class _Timeout(Exception):
    pass


def _alarm(signum, frame):
    raise _Timeout()


def safe_read(path):
    old = signal.signal(signal.SIGALRM, _alarm)
    signal.alarm(READ_TIMEOUT)
    try:
        with open(path) as f:
            return f.read().strip()
    except (_Timeout, OSError, IOError):
        return None
    finally:
        signal.alarm(0)
        signal.signal(signal.SIGALRM, old)


def find_device_dirs(base, depth=0):
    """Recursively find dirs containing idVendor, with depth limit."""
    if depth > MAX_DEPTH:
        return
    try:
        entries = os.listdir(base)
    except (OSError, IOError):
        return
    if "idVendor" in entries and "busnum" in entries:
        yield base
    for e in entries:
        if e.startswith(".") or ":" in e:
            continue
        p = os.path.join(base, e)
        try:
            if os.path.isdir(p) and not os.path.islink(p):
                yield from find_device_dirs(p, depth + 1)
        except (OSError, IOError):
            continue


def scan_device(path, seen):
    vid = safe_read(os.path.join(path, "idVendor"))
    if not vid:
        return None
    pid = safe_read(os.path.join(path, "idProduct"))
    busnum = safe_read(os.path.join(path, "busnum"))
    devnum = safe_read(os.path.join(path, "devnum"))
    if None in (pid, busnum, devnum):
        return None
    try:
        key = (int(busnum), int(devnum))
    except ValueError:
        return None
    if key in seen:
        return None
    seen.add(key)
    prod = safe_read(os.path.join(path, "product")) or ""
    mfg = safe_read(os.path.join(path, "manufacturer")) or ""
    desc = "{} {}".format(mfg, prod).strip()
    return (key[0], key[1], vid, pid, desc)


def lsusb():
    results = []
    seen = set()
    for base in [SYSFS_BASE, XHCI_BASE]:
        if not os.path.isdir(base):
            continue
        for path in find_device_dirs(base):
            r = scan_device(path, seen)
            if r:
                results.append(r)
    results.sort()
    for bus, dev, vid, pid, desc in results:
        print("Bus {:03d} Device {:03d}: ID {}:{} {}".format(bus, dev, vid, pid, desc))


if __name__ == "__main__":
    lsusb()
