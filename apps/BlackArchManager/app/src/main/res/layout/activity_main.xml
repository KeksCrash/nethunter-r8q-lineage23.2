<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f0f23"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1a1a2e"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BlackArch Manager"
            android:textColor="#1793D1"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="#888888" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Checking..."
            android:textColor="#e0e0e0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Cancel"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:background="#e94560"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            style="@style/ActionButton"
            android:background="#1793D1"
            android:textColor="#ffffff"
            android:text="Start" />

        <Button
            android:id="@+id/btnKill"
            style="@style/ActionButton"
            android:background="#e94560"
            android:textColor="#ffffff"
            android:text="Stop" />

        <Button
            android:id="@+id/btnShell"
            style="@style/ActionButton"
            android:text="Shell" />

        <Button
            android:id="@+id/btnPackages"
            style="@style/ActionButton"
            android:text="Packages" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/packageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:padding="10dp"
            android:hint="package names..."
            android:textColorHint="#707080"
            android:textColor="#e0e0e0"
            android:textSize="12sp"
            android:singleLine="true"
            android:background="#1a1a2e" />

        <Button
            android:id="@+id/btnInstall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:padding="10dp"
            android:text="Install"
            android:textSize="11sp"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:background="#1793D1" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:background="#0a0a1a"
        android:padding="6dp">

        <TextView
            android:id="@+id/terminalOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace"
            android:textColor="#00ff41"
            android:textSize="11sp"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
