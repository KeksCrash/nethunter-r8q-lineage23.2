<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/neon_panel"
    android:padding="13dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#ff536c"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SMART / UNLOCK"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="28sp"
            android:textColor="#ff405b"
            android:id="@+id/widget_symbol"
            android:layout_width="29dp"
            android:layout_height="wrap_content"
            android:text="○"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ff536c"
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PRÜFE…"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#c8b9c3"
                android:id="@+id/widget_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status wird geladen"
                android:maxLines="2"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/widget_button"
        android:background="@drawable/neon_button"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:text="UMSCHALTEN"/>
</LinearLayout>
