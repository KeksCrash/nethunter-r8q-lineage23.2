diff --git a/scripts/Kconfig.include b/scripts/Kconfig.include
index 79455ad6b3863c3b4d5a495f8644a2150b3eef0b..2605689d5e711424d48b8deb33e6c3c39cf7c24e 100644
--- a/scripts/Kconfig.include
